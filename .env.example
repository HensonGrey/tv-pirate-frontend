# Copy to .env or .env.local if the backend lives somewhere else.
# Default in code: http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Cloudflare Turnstile site key (public); unset turns the guest bot check off
# Scripts/e2e: Cloudflare's always-pass test site key 1x00000000000000000000AA, paired with the backend's test secret (backend README "Scripts and e2e suites")
VITE_TURNSTILE_SITE_KEY=
